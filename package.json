{
  "name": "e-sadad-xml",
  "version": "0.4.0",
  "description": "E-SADAD biller integration library (BillPull, PrepaidValidation, ReceivePaymentNotification, Availability) for Node.js — usable from JavaScript and TypeScript.",
  "license": "UNLICENSED",
  "keywords": [
    "esadad",
    "e-sadad",
    "biller",
    "mfep",
    "payments",
    "palestine",
    "xml",
    "signature"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.mts",
        "default": "./dist/express.mjs"
      },
      "require": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "examples/dev-keys.sh"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.cjs && node scripts/smoke.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run smoke",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage --coverage.include=src/**"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "node-forge": "^1.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/express4": "npm:@types/express@^4.17.25",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "express": "^5.3.0",
    "express4": "npm:express@^4.22.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaqoutabed/e-sadad-xml.git"
  },
  "author": "zaqoutabed"
}
